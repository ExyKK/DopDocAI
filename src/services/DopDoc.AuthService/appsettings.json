{
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Port=5432;Database=dopdoc;Username=dopdoc;Password=dopdoc"
  },
  "Db": {
    "Schema": "auth"
  },
  "Auth": {
    "JwtIssuer": "dopdoc",
    "JwtAudience": "dopdoc",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30,
    "JwtSecret": "",
    "RefreshPepper": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  }
}