{
  "Health": {
    "Ready": {
      "Postgres": {
        "Enabled": false,
        "ConnectionName": "GatewayDb",
        "TimeoutSeconds": 2
      },
      "Minio": {
        "Enabled": false,
        "Endpoint": "http://minio:9000",
        "TimeoutSeconds": 2
      },
      "Qdrant": {
        "Enabled": false,
        "BaseUrl": "http://qdrant:6333",
        "ReadyPath": "/readyz",
        "TimeoutSeconds": 2
      }
    }
  },
  "Auth": {
    "JwtIssuer": "dopdoc",
    "JwtAudience": "dopdoc",
    "JwtSecret": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth_api": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "repositories_api": {
        "ClusterId": "repos",
        "AuthorizationPolicy": "gateway.authenticated",
        "Match": {
          "Path": "/api/v1/repositories/{**catch-all}"
        }
      },
      "index_runs_api": {
        "ClusterId": "repos",
        "AuthorizationPolicy": "gateway.authenticated",
        "Match": {
          "Path": "/api/v1/index-runs/{**catch-all}"
        }
      },
      "documentation_runs_api": {
        "ClusterId": "repos",
        "AuthorizationPolicy": "gateway.authenticated",
        "Match": {
          "Path": "/api/v1/documentation-runs/{**catch-all}"
        }
      },
      "chats_api": {
        "ClusterId": "chats",
        "AuthorizationPolicy": "gateway.authenticated",
        "Match": {
          "Path": "/api/v1/chats/{**catch-all}"
        }
      },
      "ingest_api": {
        "ClusterId": "ingestion",
        "AuthorizationPolicy": "gateway.authenticated",
        "Match": {
          "Path": "/api/v1/ingest/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "rag_api": {
        "ClusterId": "ingestion",
        "AuthorizationPolicy": "gateway.authenticated",
        "Match": {
          "Path": "/api/v1/rag/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:19000/"
          }
        }
      },
      "repos": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:19200/"
          }
        }
      },
      "chats": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:19300/"
          }
        }
      },
      "ingestion": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:19100/"
          }
        }
      }
    }
  },
  "Otel": {
    "ServiceName": "edge_gateway",
    "ExporterOtlpEndpoint": "http://otel_collector:4317",
    "EnableTracing": true,
    "EnableMetrics": true
  },
  "Correlation": {
    "HeaderName": "X-Correlation-Id",
    "UseTraceIdAsCorrelationId": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://otel_collector:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
            "service.name": "edge_gateway"
          }
        }
      }
    ]
  }
}
